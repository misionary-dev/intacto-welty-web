{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "intacto-welty-web",
  "compatibility_date": "2026-09-17",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "intacto.misionary.dev",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
